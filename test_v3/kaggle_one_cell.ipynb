        "from pathlib import Path\n",
        "import runpy\n",
        "matches = sorted(Path('/kaggle/input').glob('**/kaggle_one_cell.py'))\n",
        "if len(matches) != 1:\n",
        "    raise RuntimeError(f'Expected exactly one V3 entry point under /kaggle/input, found: {matches}')\n",
        "runpy.run_path(str(matches[0]), run_name='__main__')\n"
      ]
    }
